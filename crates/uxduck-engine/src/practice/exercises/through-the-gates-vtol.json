  "steps": [
    {
      "text": "Switch to FBWB and fly it forward with your controller.",
      "hint": "FBWB is under Modes in the Cockpit tab. You steer with the roll stick; centred, the pitch stick holds its height. It leaves the hover and flies like a plane.",
      "hintAfterS": 45,
      "all": [
        {
          "check": "mode",
          "mode": "FBWB"
        }
      ]
    },
    {
      "text": "Fly through gate 1.",
      "hint": "Fly across the gate's line on the map, between its ends, at 30 to 100 m up. Bank gently: it needs room to turn.",
      "hintAfterS": 90,
      "all": [
        {
          "check": "gateCrossed",
          "feature": "gate-1",
          "minM": 30,
          "maxM": 100
        }
      ]
    },
    {
      "text": "Now gate 2.",
