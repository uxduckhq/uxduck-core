{
  "id": "bring-it-home",
  "version": 1,
  "title": "Bring it home",
  "audience": "first-flight",
  "vehicles": ["multicopter"],
  "goal": "Get it back on the ground at home before the battery runs low.",
  "start": {
    "heightM": 50,
    "offset": { "bearingDeg": 90, "distanceM": 400 },
    "batteryPct": 35,
    "parameters": [{ "name": "BATT_CAPACITY", "value": 10000 }]
  },
  "features": [{ "id": "home", "label": "Home", "radiusM": 20 }],
  "steps": [
    {
      "text": "Press Return to launch in the Cockpit tab.",
      "hint": "Return to launch flies it home and lands it by itself.",
      "hintAfterS": 60,
      "all": [{ "check": "commandSent", "command": "rtl" }]
    },
    {
      "text": "Wait for it to land at home.",
      "hint": "It climbs, flies back and lands. Watch it on the map.",
      "hintAfterS": 120,
      "all": [{ "check": "landed" }, { "check": "within", "feature": "home" }]
    }
  ],
  "fails": [
    {
      "all": [{ "check": "batteryBelow", "pct": 15 }, { "check": "airborne" }],
      "says": "Failed. The battery ran low with the vehicle still in the air."
    },
    {
      "all": [{ "check": "landed" }, { "check": "outside", "feature": "home" }],
      "says": "Failed. Landed {distance:home} m from home."
    }
  ],
  "passed": "Passed. Home with {battery}% left.",
  "measure": { "measure": "batteryRemaining" }
}
