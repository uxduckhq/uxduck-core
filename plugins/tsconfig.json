{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@uxduck/sdk": ["../packages/sdk/src/index.ts"],
      "@uxduck/protocol": ["../packages/protocol/src/generated/types.gen.ts"]
    }
  },
  "include": ["*/index.ts"]
}
