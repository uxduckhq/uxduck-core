--- /dev/null
+++ b/libraries/AP_HAL/utility/SITL_Network.h
@@ -0,0 +1,53 @@
+// UXDuck builds stay local even when started by an older installed daemon.
+#pragma once
+#include <arpa/inet.h>
+#include <errno.h>
+#include <sys/socket.h>
+
+namespace SITLNetwork {
+inline bool &local_only()
+{
+    static bool enabled = true;
+    return enabled;
+}
+
+inline bool allow_destination(uint32_t network_address)
+{
+    if (!local_only() || (ntohl(network_address) & 0xff000000U) == 0x7f000000U) {
+        return true;
+    }
+    errno = EACCES;
+    return false;
+}
+
+inline bool bind_address(struct sockaddr_in &address)
+{
+    if (local_only() && address.sin_addr.s_addr == htonl(INADDR_ANY)) {
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    }
+    return allow_destination(address.sin_addr.s_addr);
+}
+
+// Windows can leave even a connected UDP socket bound to INADDR_ANY.
+// Bind clients before connect/sendto, without rebinding an explicit RC port.
+inline bool bind_client(int fd)
+{
+    if (!local_only()) {
+        return true;
+    }
+    struct sockaddr_in address {};
+    socklen_t length = sizeof(address);
+    if (getsockname(fd, (struct sockaddr *)&address, &length) != 0 && errno != EINVAL) {
+        return false;
+    }
+    if (address.sin_port != 0) {
+        return allow_destination(address.sin_addr.s_addr);
+    }
+    address.sin_family = AF_INET;
+#ifdef HAVE_SOCK_SIN_LEN
+    address.sin_len = sizeof(address);
+#endif
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    return bind(fd, (struct sockaddr *)&address, sizeof(address)) == 0;
+}
+}
